# ==============================================================================
# Wasl Islamic (وصل الإسلامية) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# The application is designed to be 100% functional even without Supabase
# credentials, falling back cleanly to IndexedDB and LocalStorage for guest users.
# ==============================================================================

# Supabase Public API Configuration
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Application Metadata
NEXT_PUBLIC_APP_NAME="وصل الإسلامية"
NEXT_PUBLIC_APP_URL=https://waslislam.fun

# Optional Quran & Audio Provider Overrides
NEXT_PUBLIC_QURAN_API_URL=https://api.alquran.cloud/v1
NEXT_PUBLIC_AUDIO_CDN_URL=https://everyayah.com/data

# ==============================================================================
# Hostinger Real Email Notification System
# ==============================================================================
# Server-side SMTP credentials for Hostinger Mailbox delivery.
# Never expose these credentials in browser-side code or commit them to Git.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notifications@your-domain.com
SMTP_PASS=YOUR_HOSTINGER_MAILBOX_PASSWORD

# Sender Identification
MAIL_FROM_NAME="منصة وصل الإسلامية"
MAIL_FROM_ADDRESS=notifications@your-domain.com

# Site URL for generating verification & unsubscribe links
SITE_URL=https://waslislam.fun

# Operational Admin Alerts (receives failure alerts when delivery batches fail)
NOTIFICATION_ADMIN_EMAIL=admin@your-domain.com

# Secret token to authorize recurring cron delivery via /api/notifications/cron/daily
NOTIFICATION_CRON_SECRET=your_secure_random_cron_token_here

# PostgreSQL Database Connection URL for subscriber persistence and delivery logs
DATABASE_URL=postgresql://postgres:PASSWORD@db.your-supabase.co:5432/postgres

# Server-side HMAC secret for protecting numeric OTP challenges
OTP_SECRET=your_high_entropy_random_otp_secret_key_here
